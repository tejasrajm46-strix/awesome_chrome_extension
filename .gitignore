# The packaged extension IS shipped in this repository: releases/*.zip is what
# "download -> unzip -> Load unpacked" points at, so it must not be ignored. Only the
# throwaway staging directory the ZIP is built from is.
/releases/build/

# Packed extension artifacts and signing material
*.crx
*.pem
*.key

# OS and editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp

# The tooling session directory and the outer "push" archive are not part of the
# shipped extension (the real artifact is releases/*.zip).
/.commandcode/
/glass-new-tab-v1.3.0-push.zip
